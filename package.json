{
  "name": "api",
  "version": "1.0.0",
  "description": "Simple movies API using clean architecture",
  "main": "dist/server.js",
  "scripts": {
    "test": "jest",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "generate:openapi": "node scripts/generate-openapi.cjs",
    "build": "npm run clean && tsc --noEmit && npm run generate:openapi && esbuild server.ts --bundle --platform=node --target=node18 --minify --external:express --external:mongodb --external:swagger-ui-express --external:swagger-ui-dist --outfile=dist/server.js",
    "start": "npm run build && node dist/server.js",
    "dev": "npm run build && node --watch dist/server.js"
  },
  "author": "diogo.mendes@hotmail.com",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "mongodb": "^7.6.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "esbuild": "^0.25.12",
    "jest": "^30.4.2",
    "swagger-jsdoc": "^6.3.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  }
}
